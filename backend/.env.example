NODE_ENV=development
PORT=4000

# Debe apuntar a un replica set (aunque sea de un solo nodo) para soportar
# las transacciones usadas en la creación de reservas.
MONGO_URI=mongodb://mongo:27017/atlas-spaces?replicaSet=rs0

# Cambiar por un valor propio y seguro - nunca subir el real al repositorio.
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=8h

APP_TIMEZONE=America/Bogota
CORS_ORIGIN=http://localhost:5173
